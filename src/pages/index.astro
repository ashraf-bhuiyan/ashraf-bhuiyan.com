---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.profile {
				display: flex;
				align-items: center;
				gap: 1.5em;
				padding: 3em 0 2em;
			}
			.avatar {
				width: 96px;
				height: 96px;
				border-radius: 50%;
				object-fit: cover;
				flex-shrink: 0;
			}
			.profile-info h1 {
				font-size: 1.6em;
				margin: 0 0 0.2em;
			}
			.profile-info .bio {
				color: var(--text-secondary);
				margin: 0 0 0.6em;
				font-size: 0.95em;
				line-height: 1.5;
			}
			.social-links {
				display: flex;
				gap: 0.75em;
				align-items: center;
			}
			.social-links a {
				color: var(--text-secondary);
				transition: color 0.15s;
				display: flex;
				align-items: center;
			}
			.social-links a:hover {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.section-title {
				font-size: 1em;
				font-weight: 600;
				color: var(--text-secondary);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin: 2em 0 0.75em;
				padding-bottom: 0.5em;
				border-bottom: 1px solid var(--border);
			}
			.series-header {
				margin-bottom: 0.5em;
			}
			.series-header h3 {
				font-size: 1.15em;
				margin: 0;
			}
			.series-header h3 a {
				color: rgb(var(--black));
			}
			.series-header h3 a:hover {
				color: var(--accent);
			}
			.series-desc {
				color: var(--text-secondary);
				font-size: 0.9em;
				margin: 0.25em 0 0;
			}
			.arch-diagram {
				margin: 1.5em 0 2.5em;
				overflow-x: auto;
			}
			.arch-diagram svg {
				display: block;
				margin: 0 auto;
				max-width: 100%;
				height: auto;
			}
			.arch-diagram text {
				font-family: var(--font-atkinson), system-ui, sans-serif;
			}
			.arch-diagram a text {
				fill: var(--accent);
			}
			.arch-diagram a:hover text {
				text-decoration: underline;
				fill: var(--accent-dark);
			}
			.arch-diagram a rect {
				transition: stroke 0.15s;
			}
			.arch-diagram a:hover rect {
				stroke: var(--accent);
			}
			.series-list {
				margin: 0 0 2em;
			}
			.series-list ol {
				padding-left: 1.8em;
				margin: 0;
			}
			.series-list li {
				padding: 0.25em 0;
				font-size: 0.92em;
				line-height: 1.6;
			}
			.series-list a {
				font-weight: 600;
			}
			.list-desc {
				color: var(--text-secondary);
				font-size: 0.9em;
			}
			@media (max-width: 720px) {
				.profile {
					padding: 2em 0 1.5em;
				}
				.avatar {
					width: 72px;
					height: 72px;
				}
				.profile-info h1 {
					font-size: 1.3em;
				}
				.list-desc {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="profile">
				<img src="/IMG_5015.JPG" alt="Ashraf Bhuiyan" class="avatar" />
				<div class="profile-info">
					<h1>Ashraf Bhuiyan</h1>
					<p class="bio">
						Engineering Leader for AI Inference. Currently leading vLLM team at Red Hat. Expert in AI inference systems, Architecture, GPU programming, and building production large scale LLM infrastructure.
					</p>
					<div class="social-links">
						<a href="https://github.com/ashraf-bhuiyan" target="_blank" aria-label="GitHub">
							<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
								<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
							</svg>
						</a>
						<a href="https://www.linkedin.com/in/mohammad-ashraf-bhuiyan-11725b16/" target="_blank" aria-label="LinkedIn">
							<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
								<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</a>
						<a href="https://x.com/AshrafBhuiyanM" target="_blank" aria-label="X (Twitter)">
							<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
								<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</a>
					</div>
				</div>
			</div>

			<h2 class="section-title">Writing</h2>

			<div class="series-header">
				<h3><a href="/blog/">Building an LLM Inference Engine from Scratch</a></h3>
				<p class="series-desc">{posts.length} parts &middot; Learn the internals of vLLM and SGLang</p>
			</div>

			<div class="arch-diagram">
				<svg viewBox="0 0 720 410" xmlns="http://www.w3.org/2000/svg" width="720" height="410">
					<!-- Blog 1: Foundation -->
					<a href="/blog/01-naive-inference/">
						<rect x="260" y="8" width="200" height="44" rx="6" fill="none" stroke="currentColor" stroke-width="1.5"/>
						<text x="360" y="28" text-anchor="middle" font-size="11" font-weight="600">1 · Naive Inference</text>
						<text x="360" y="44" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.5">foundation</text>
					</a>

					<!-- Lines from Blog 1 down -->
					<line x1="360" y1="52" x2="360" y2="72" stroke="currentColor" stroke-width="1.2"/>
					<line x1="120" y1="72" x2="600" y2="72" stroke="currentColor" stroke-width="1.2"/>
					<line x1="120" y1="72" x2="120" y2="92" stroke="currentColor" stroke-width="1.2"/>
					<line x1="360" y1="72" x2="360" y2="92" stroke="currentColor" stroke-width="1.2"/>
					<line x1="600" y1="72" x2="600" y2="92" stroke="currentColor" stroke-width="1.2"/>
					<polygon points="120,92 116,84 124,84" fill="currentColor"/>
					<polygon points="360,92 356,84 364,84" fill="currentColor"/>
					<polygon points="600,92 596,84 604,84" fill="currentColor"/>

					<!-- INDEPENDENT column -->
					<rect x="30" y="92" width="180" height="175" rx="6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 2"/>
					<text x="120" y="112" text-anchor="middle" fill="currentColor" font-size="10" font-weight="600">INDEPENDENT</text>
					<text x="120" y="126" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.5">(toggle on/off)</text>

					<a href="/blog/02-async-streaming/">
						<text x="120" y="150" text-anchor="middle" font-size="10">2  Async Streaming</text>
					</a>
					<a href="/blog/07-prefix-caching/">
						<text x="120" y="170" text-anchor="middle" font-size="10">7  Prefix Caching</text>
					</a>
					<a href="/blog/08-speculative-decoding/">
						<text x="120" y="190" text-anchor="middle" font-size="10">8  Spec. Decoding</text>
					</a>
					<a href="/blog/12-kv-cpu-offloading/">
						<text x="120" y="210" text-anchor="middle" font-size="10">12 CPU Offloading</text>
					</a>
					<a href="/blog/14-quantization/">
						<text x="120" y="230" text-anchor="middle" font-size="10">14 Quantization</text>
					</a>

					<!-- DEPENDENCY CHAIN column -->
					<rect x="240" y="92" width="240" height="175" rx="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
					<text x="360" y="112" text-anchor="middle" fill="currentColor" font-size="10" font-weight="600">DEPENDENCY CHAIN</text>

					<a href="/blog/03-paged-attention/">
						<rect x="295" y="124" width="130" height="28" rx="4" fill="none" stroke="currentColor" stroke-width="1"/>
						<text x="360" y="142" text-anchor="middle" font-size="10">3 Paged Attention</text>
					</a>

					<line x1="360" y1="152" x2="360" y2="166" stroke="currentColor" stroke-width="1"/>
					<polygon points="360,166 356,160 364,160" fill="currentColor"/>

					<a href="/blog/04-continuous-batching/">
						<rect x="290" y="166" width="140" height="28" rx="4" fill="none" stroke="currentColor" stroke-width="1"/>
						<text x="360" y="184" text-anchor="middle" font-size="10">4 Cont. Batching</text>
					</a>

					<line x1="330" y1="194" x2="330" y2="212" stroke="currentColor" stroke-width="1"/>
					<line x1="390" y1="194" x2="390" y2="212" stroke="currentColor" stroke-width="1"/>
					<polygon points="330,212 326,206 334,206" fill="currentColor"/>
					<polygon points="390,212 386,206 394,206" fill="currentColor"/>

					<a href="/blog/05-async-scheduling/">
						<rect x="275" y="212" width="110" height="28" rx="4" fill="none" stroke="currentColor" stroke-width="1"/>
						<text x="330" y="230" text-anchor="middle" font-size="10">5 Async Sched</text>
					</a>

					<a href="/blog/06-chunked-prefill/">
						<rect x="390" y="212" width="80" height="28" rx="4" fill="none" stroke="currentColor" stroke-width="1"/>
						<text x="430" y="230" text-anchor="middle" font-size="10">6 Chunked</text>
					</a>

					<!-- PARALLELISM column -->
					<rect x="510" y="92" width="180" height="175" rx="6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 2"/>
					<text x="600" y="112" text-anchor="middle" fill="currentColor" font-size="10" font-weight="600">PARALLELISM</text>
					<text x="600" y="126" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.5">(pick per hardware)</text>

					<a href="/blog/09-tensor-parallelism/">
						<text x="600" y="150" text-anchor="middle" font-size="10">9   Tensor  ∥</text>
					</a>
					<a href="/blog/10-data-parallelism/">
						<text x="600" y="170" text-anchor="middle" font-size="10">10  Data    ∥</text>
					</a>
					<a href="/blog/11-expert-parallelism/">
						<text x="600" y="190" text-anchor="middle" font-size="10">11  Expert  ∥</text>
					</a>
					<text x="600" y="222" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.5">DP x TP x EP = total GPUs</text>

					<!-- Lines merging down -->
					<line x1="120" y1="267" x2="120" y2="290" stroke="currentColor" stroke-width="1.2"/>
					<line x1="360" y1="267" x2="360" y2="290" stroke="currentColor" stroke-width="1.2"/>
					<line x1="600" y1="267" x2="600" y2="290" stroke="currentColor" stroke-width="1.2"/>
					<line x1="120" y1="290" x2="600" y2="290" stroke="currentColor" stroke-width="1.2"/>
					<line x1="360" y1="290" x2="360" y2="310" stroke="currentColor" stroke-width="1.2"/>
					<polygon points="360,310 356,302 364,302" fill="currentColor"/>

					<!-- Blog 13 -->
					<a href="/blog/13-disaggregated-serving/">
						<rect x="260" y="310" width="200" height="40" rx="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
						<text x="360" y="328" text-anchor="middle" font-size="11" font-weight="600">13 · Disaggregated P/D</text>
						<text x="360" y="343" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.5">system architecture</text>
					</a>

					<line x1="360" y1="350" x2="360" y2="368" stroke="currentColor" stroke-width="1.2"/>
					<polygon points="360,368 356,360 364,360" fill="currentColor"/>

					<!-- Blog 15 -->
					<a href="/blog/15-full-architecture/">
						<rect x="255" y="368" width="210" height="40" rx="6" fill="none" stroke="currentColor" stroke-width="2"/>
						<text x="360" y="386" text-anchor="middle" font-size="11" font-weight="700">15 · Full Architecture</text>
						<text x="360" y="401" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.5">all combined</text>
					</a>
				</svg>
			</div>

			<!-- Series: LoRA & QLoRA -->
			<div class="series-header">
				<h3><a href="/blog/lora-01-fundamentals/">LoRA & QLoRA in vLLM</a></h3>
				<p class="series-desc">6 parts &middot; From LoRA math to production multi-adapter serving</p>
			</div>
			<div class="series-list">
				<ol>
					<li><a href="/blog/lora-01-fundamentals/">LoRA Fundamentals</a> <span class="list-desc">&mdash; B&times;A decomposition, rank, alpha, target modules</span></li>
					<li><a href="/blog/lora-02-qlora/">QLoRA</a> <span class="list-desc">&mdash; NF4 quantization, 4-bit base + full-precision adapters</span></li>
					<li><a href="/blog/lora-03-serving/">Serving a LoRA Adapter</a> <span class="list-desc">&mdash; --enable-lora, LoRARequest, on-the-fly forward pass</span></li>
					<li><a href="/blog/lora-04-multi-lora/">Multi-LoRA Serving</a> <span class="list-desc">&mdash; adapter cache, LRU eviction, routing patterns</span></li>
					<li><a href="/blog/lora-05-kernels/">Kernel Internals</a> <span class="list-desc">&mdash; SGMV/BGMV, PunicaWrapper, weight stacking</span></li>
					<li><a href="/blog/lora-06-production/">Production at Scale</a> <span class="list-desc">&mdash; S-LoRA, TP/DP composition, tuning checklist</span></li>
				</ol>
			</div>

			<!-- Series: Embeddings, Pooling & Rerankers -->
			<div class="series-header">
				<h3><a href="/blog/embed-01-fundamentals/">Embeddings, Pooling & Rerankers in vLLM</a></h3>
				<p class="series-desc">5 parts &middot; Embedding fundamentals through high-throughput optimization</p>
			</div>
			<div class="series-list">
				<ol>
					<li><a href="/blog/embed-01-fundamentals/">Embedding Fundamentals</a> <span class="list-desc">&mdash; bi-encoders, contrastive learning, similarity metrics</span></li>
					<li><a href="/blog/embed-02-pooling/">Pooling Strategies</a> <span class="list-desc">&mdash; CLS, mean, last-token, normalization pitfalls</span></li>
					<li><a href="/blog/embed-03-serving/">Serving Embeddings</a> <span class="list-desc">&mdash; --task embed, /v1/embeddings API, PoolingParams</span></li>
					<li><a href="/blog/embed-04-rerankers/">Rerankers & Cross-Encoders</a> <span class="list-desc">&mdash; --task score, retrieve-then-rerank, reward models</span></li>
					<li><a href="/blog/embed-05-optimization/">Throughput Optimization</a> <span class="list-desc">&mdash; saturation curves, prefix caching, benchmarking</span></li>
				</ol>
			</div>

			<!-- Series: Vision, Language & Audio -->
			<div class="series-header">
				<h3><a href="/blog/mm-01-vlm-architecture/">Vision, Language & Audio Models in vLLM</a></h3>
				<p class="series-desc">6 parts &middot; VLM architecture through multi-modal serving optimization</p>
			</div>
			<div class="series-list">
				<ol>
					<li><a href="/blog/mm-01-vlm-architecture/">VLM Architecture Primer</a> <span class="list-desc">&mdash; vision encoders, projection layers, model families</span></li>
					<li><a href="/blog/mm-02-serving-vlms/">Serving VLMs</a> <span class="list-desc">&mdash; OpenAI vision API, image input, preprocessing</span></li>
					<li><a href="/blog/mm-03-multi-image-video/">Multi-Image & Video</a> <span class="list-desc">&mdash; token explosion, frame sampling, memory management</span></li>
					<li><a href="/blog/mm-04-audio-models/">Audio & Speech Models</a> <span class="list-desc">&mdash; Whisper encoder, mel spectrograms, Qwen2-Audio</span></li>
					<li><a href="/blog/mm-05-internals/">Multi-Modal Internals</a> <span class="list-desc">&mdash; registry, plugins, processor, placeholder replacement</span></li>
					<li><a href="/blog/mm-06-optimization/">Optimization</a> <span class="list-desc">&mdash; prefix caching, chunked prefill, TP, resolution tuning</span></li>
				</ol>
			</div>
		</main>
		<Footer />
	</body>
</html>
