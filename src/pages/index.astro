---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 6em 1em 4em;
			}
			.hero h1 {
				font-size: 2.4em;
				margin-bottom: 0.4em;
				line-height: 1.2;
			}
			.hero .subtitle {
				font-size: 1.15em;
				color: var(--text-secondary);
				max-width: 600px;
				margin: 0 auto 1.5em;
				line-height: 1.6;
			}
			.hero .frameworks {
				font-size: 1em;
				color: var(--text-secondary);
				margin-bottom: 2em;
			}
			.cta {
				display: inline-block;
				padding: 0.75em 2em;
				background: rgb(var(--accent));
				color: #fff;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 600;
				font-size: 1.05em;
				transition: opacity 0.15s;
			}
			.cta:hover {
				opacity: 0.85;
				text-decoration: none;
			}
			@media (max-width: 720px) {
				.hero { padding: 4em 1em 3em; }
				.hero h1 { font-size: 1.7em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Building an LLM Inference Engine from Scratch</h1>
				<p class="subtitle">
					A 15-part series teaching how production inference servers work by building one from scratch.
					Each post isolates one technique with a runnable Python implementation.
				</p>
				<p class="frameworks">
					Learn the internals of <strong>vLLM</strong> and <strong>SGLang</strong>
				</p>
				<a href="/blog/" class="cta">Read the Series</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
