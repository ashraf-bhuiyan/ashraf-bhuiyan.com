---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0));

const seriesMap = new Map<string, typeof posts>();
for (const post of posts) {
	const series = post.data.series ?? 'Other';
	if (!seriesMap.has(series)) seriesMap.set(series, []);
	seriesMap.get(series)!.push(post);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.profile {
				display: flex;
				align-items: center;
				gap: 1.5em;
				padding: 3em 0 2em;
			}
			.avatar {
				width: 96px;
				height: 96px;
				border-radius: 50%;
				object-fit: cover;
				flex-shrink: 0;
			}
			.profile-info h1 {
				font-size: 1.6em;
				margin: 0 0 0.2em;
			}
			.profile-info .bio {
				color: var(--text-secondary);
				margin: 0 0 0.6em;
				font-size: 0.95em;
				line-height: 1.5;
			}
			.social-links {
				display: flex;
				gap: 0.75em;
				align-items: center;
			}
			.social-links a {
				color: var(--text-secondary);
				transition: color 0.15s;
				display: flex;
				align-items: center;
			}
			.social-links a:hover {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.section-title {
				font-size: 1em;
				font-weight: 600;
				color: var(--text-secondary);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin: 2em 0 0.75em;
				padding-bottom: 0.5em;
				border-bottom: 1px solid var(--border);
			}
			.series-block {
				margin-bottom: 2.5em;
			}
			.series-header {
				margin-bottom: 0.5em;
			}
			.series-header h3 {
				font-size: 1.15em;
				margin: 0;
			}
			.series-header h3 a {
				color: rgb(var(--black));
			}
			.series-header h3 a:hover {
				color: var(--accent);
			}
			.series-desc {
				color: var(--text-secondary);
				font-size: 0.9em;
				margin: 0.25em 0 0;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0.5em 0 0;
			}
			.post-list li a {
				display: flex;
				gap: 0.75em;
				padding: 0.5em 0.75em;
				border-radius: 6px;
				text-decoration: none;
				transition: background-color 0.15s;
				align-items: baseline;
			}
			.post-list li a:hover {
				background: var(--bg-secondary);
				text-decoration: none;
			}
			.part-num {
				font-size: 0.8em;
				font-weight: 600;
				color: var(--text-secondary);
				min-width: 2em;
				flex-shrink: 0;
			}
			.post-title {
				color: rgb(var(--black));
				font-size: 0.95em;
			}
			@media (max-width: 720px) {
				.profile {
					padding: 2em 0 1.5em;
				}
				.avatar {
					width: 72px;
					height: 72px;
				}
				.profile-info h1 {
					font-size: 1.3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="profile">
				<img src="/IMG_5015.JPG" alt="Ashraf Bhuiyan" class="avatar" />
				<div class="profile-info">
					<h1>Ashraf Bhuiyan</h1>
					<p class="bio">
						Engineering Manager for vLLM. Writing about ML inference systems, GPU programming, and building production LLM infrastructure.
					</p>
					<div class="social-links">
						<a href="https://github.com/ashraf-bhuiyan" target="_blank" aria-label="GitHub">
							<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
								<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
							</svg>
						</a>
						<a href="https://www.linkedin.com/in/mohammad-ashraf-bhuiyan-11725b16/" target="_blank" aria-label="LinkedIn">
							<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
								<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</a>
						<a href="https://x.com/AshrafBhuiyanM" target="_blank" aria-label="X (Twitter)">
							<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
								<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</a>
					</div>
				</div>
			</div>

			<h2 class="section-title">Writing</h2>

			{[...seriesMap.entries()].map(([series, seriesPosts]) => (
				<div class="series-block">
					<div class="series-header">
						<h3><a href="/blog/">{series}</a></h3>
						<p class="series-desc">{seriesPosts.length} parts &middot; Learn the internals of vLLM and SGLang</p>
					</div>
					<ul class="post-list">
						{seriesPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.part && <span class="part-num">{String(post.data.part).padStart(2, '0')}</span>}
									<span class="post-title">{post.data.title}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</main>
		<Footer />
	</body>
</html>
